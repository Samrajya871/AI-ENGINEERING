   id INTEGER PRIMARY KEY,
   title TEXT,
   author TEXT,
   year INTEGER);
 

INSERT INTO books VALUES
(1, &quot;ASOIAF&quot;,&quot;GRRM&quot;,1992),
(2,&quot;LOTR&quot;,&quot;TOLKEIN&quot;,1934),
(3,&quot;RR&quot;,&quot;PIERCE BROWN&quot;,2014),
(4,&quot;DUNE&quot;,&quot;FRANK HERBET&quot;,1970),
(5,&quot;METAMORPHOSIS&quot;,&quot;KRANZ KAFKA&quot;,1900);

SELECT * FROM books;

SELECT title FROM books;

SELECT * FROM books
WHERE year&gt;2010;

SELECT * FROM books
ORDER BY year DESC;

SELECT * FROM books
LIMIT 3;

SELECT title, author FROM books;
