SELECT * FROM students;

SELECT name,email FROM students;

SELECT * FROM students
WHERE age&gt;21;

SELECT * FROM students
WHERE course=&quot;Physics&quot;;

SELECT * FROM students
ORDER BY age asc; 

SELECT * FROM students
LIMIT 5;</sql><current_tab id="0"/></tab_sql></sqlb_project>
